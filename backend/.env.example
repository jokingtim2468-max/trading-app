# Copy to .env (or set as real environment variables) - all optional.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# Force the simulated broker even on Windows (1/0). Auto-enabled when MetaTrader5 can't be imported.
BRIDGE_SIM=0
# If set, the frontend must connect with ?token=<value>
BRIDGE_API_TOKEN=
# Poll intervals
TICK_POLL_MS=100
POSITIONS_POLL_MS=250
EXTERNAL_POLL_S=3
# Max deviation (points) for market orders
MAX_DEVIATION=20
# Path to terminal64.exe if you run several MT5 installs
MT5_PATH=
# Docker / auto-connect (prefer *_FILE variants pointing at docker secrets)
MT5_RPYC_HOST=
MT5_RPYC_PORT=18812
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
TV_SESSIONID=
TV_SESSIONID_SIGN=
# Extra browser origins allowed to open the WebSocket (localhost is always allowed)
BRIDGE_ALLOWED_ORIGINS=
HEALTH_INTERVAL_S=15
